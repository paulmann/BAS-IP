# BAS-IP environment overrides (optional — the local PHP config file is preferred).
# Copy to `.env` and chmod 600. `.env` is git-ignored.
#
# Any config key can be overridden: BASIP_<SECTION>_<KEY>, nested with double underscore.
#   'db' => ['connections' => ['mysql' => ['password' => 'x']]]
#   => BASIP_DB__CONNECTIONS__MYSQL__PASSWORD=x

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://gate.example.com
APP_TIMEZONE=Europe/Moscow

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bas_ip
DB_USERNAME=bas_ip
DB_PASSWORD=

DEVICE_BASE_URL=http://192.168.1.20/api/v0/
DEVICE_LOGIN=admin
DEVICE_PASSWORD=

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="BAS-IP Gate"

TELEGRAM_BOT_TOKEN=
GITHUB_TOKEN=

UPDATE_ENABLED=true
UPDATE_MODE=notify
